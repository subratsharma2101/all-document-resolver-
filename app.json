{
  "expo": {
    "name": "fileviewer",
    "slug": "fileviewer",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "fileviewer",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.subrat.fileviewer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "content",
              "mimeType": "image/*"
            },
            {
              "scheme": "content",
              "mimeType": "text/*"
            },
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "file",
              "mimeType": "image/*"
            },
            {
              "scheme": "file",
              "mimeType": "text/*"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "image/*"
            ],
            "multipleShareMimeTypes": []
          }
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "This app needs camera access to scan documents."
        }
      ]
    ]
  }
}
